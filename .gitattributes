# Normalize all text files to LF in the repo and on checkout.
# Overrides core.autocrlf for all contributors.
* text=auto eol=lf

# Explicit binary markers — never touch line endings.
*.ico  binary
*.exe  binary
*.zip  binary
*.whl  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pyc  binary
